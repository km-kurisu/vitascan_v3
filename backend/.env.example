# VitaScan V3 Backend Environment Configuration

PORT=8000
ENV=development

# Groq API Keys (Separate Vision and RAG API Keys)
GROQ_VISION_API_KEY=gsk_your_groq_vision_api_key_here
GROQ_RAG_API_KEY=gsk_your_groq_rag_api_key_here
GROQ_API_KEY=gsk_your_fallback_groq_api_key_here

# OCR Executable
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Supabase Database Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Brevo Email Reminder Integration API Key & Sender
BREVO_API_KEY=xkeysib_your_brevo_api_key_here
BREVO_FROM=VitaScan <noreply@vitascan.ai>

# SMTP Fallback Settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
